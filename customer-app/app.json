{
  "expo": {
    "name": "ShravanKirana Customer",
    "slug": "shravankirana-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shravankirana.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show nearby stores and calculate delivery times.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location to track your delivery even when the app is in the background."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundImage": "./assets/brand/adaptive-background.png",
        "backgroundColor": "#6C3CF4"
      },
      "package": "com.shravankirana.customer",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "scheme": "shravankirana",
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 88,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/brand/splash-dark.png",
            "backgroundColor": "#0F0F0F"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "81680cdd-a244-4757-943a-2b8b95cb6285"
      }
    }
  }
}
