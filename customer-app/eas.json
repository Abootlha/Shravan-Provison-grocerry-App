{
  "cli": {
    "version": ">= 24.12.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "PUBLIC_NODE_ENV": "development",
        "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "NODE_ENV": "production",
        "PUBLIC_NODE_ENV": "production",
        "API_BASE_URL": "https://api.lumioui.com/api/v1",
        "TRACKING_URL": "https://api.lumioui.com/tracking",
        "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",
        "PUBLIC_NODE_ENV": "production",
        "API_BASE_URL": "https://api.lumioui.com/api/v1",
        "TRACKING_URL": "https://api.lumioui.com/tracking",
        "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
