# Local development only. Production/preview builds take these from the EAS
# build profile `env` in eas.json (or EAS environment variables) and never fall
# back to localhost.
#
# PUBLIC_NODE_ENV=production marks a production build (also implied by the EAS
# "production"/"preview" profiles).

PUBLIC_NODE_ENV=development
API_BASE_URL=http://localhost:3000/api/v1
TRACKING_URL=http://localhost:3000/tracking

# Dev build against the deployed backend instead of a local one: copy this file
# to .env and set
#   API_BASE_URL=https://api.lumioui.com/api/v1
#   TRACKING_URL=https://api.lumioui.com/tracking
# then restart Metro with `npx expo start --clear` (values are read at bundle
# time). `localhost` URLs are rewritten to the Metro host's LAN IP, so a phone
# only gets data if a backend with a stocked catalogue runs on this machine.
# Check what a running build uses: the Metro log prints `[config] API_BASE_URL=...`
# on start, and long-pressing the avatar on Home shows it (dev builds only).

# Optional per-service overrides (default to API_BASE_URL)
# AUTH_SERVICE_URL=
# USER_SERVICE_URL=
# RIDER_SERVICE_URL=
# ORDER_SERVICE_URL=
# PRODUCT_SERVICE_URL=
# CART_SERVICE_URL=
# LOCATION_SERVICE_URL=

# MapMyIndia public key (optional). Never put MAPMYINDIA_CLIENT_SECRET in an app
# env file: anything here is embedded in the app bundle.
MAPMYINDIA_API_KEY=

# Google Maps SDK key, injected into ios.config / android.config at build time.
# Restrict it to the app's bundle id / package + SHA-1 in Google Cloud Console.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
