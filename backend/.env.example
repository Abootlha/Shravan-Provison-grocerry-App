# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/shravankirana

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# HTTP
# Comma separated browser origins allowed by CORS (admin panel, website).
# Native mobile apps send no Origin header and are always allowed.
# In development, localhost / LAN / exp:// origins are also allowed automatically.
CORS_ORIGINS=https://admin.example.com,https://www.example.com
# Express "trust proxy" setting: number of reverse-proxy hops in front of the
# app (1 for a single nginx/load balancer), or true/false. Used for per-client rate limiting.
TRUST_PROXY=1

# JWT Authentication
# REQUIRED in production (boot fails without them): at least 32 random chars each,
# and the two must be different. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development, if unset, a random per-process secret is used (tokens die on restart).
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=28d

# 2Factor.in OTP Service
# Required outside development (without it OTPs are only printed to the dev log).
TWOFACTOR_API_KEY=your-twofactor-api-key
# 2Factor SMS template name used for custom OTPs.
TWOFACTOR_TEMPLATE_NAME=OTP1
# OTP digits (4-6). The mobile apps currently expect 4; raise to 6 once they support it.
OTP_LENGTH=4

# Mappls / MapMyIndia APIs (Alternative - can be disabled if using Google Maps)
MAPMYINDIA_API_KEY=your-mappls-api-key-here
MAPMYINDIA_CLIENT_ID=your-mappls-client-id-here
MAPMYINDIA_CLIENT_SECRET=your-mappls-client-secret-here

# Google Maps API (Primary - for iOS/Android maps, search, tracking)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Store Location (for delivery radius and search bounding)
STORE_LATITUDE=26.7588
STORE_LONGITUDE=83.3700
STORE_MAX_DELIVERY_KM=15

# Socket.io Configuration
SOCKET_IO_CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Order Tracking Configuration
STALE_ORDER_THRESHOLD_MINUTES=10
ANOMALY_THRESHOLD_HOURS=2
ETA_RECALC_INTERVAL_MINUTES=5

# Performance Configuration
REDIS_CACHE_TTL_SECONDS=300
ETA_CACHE_TTL_SECONDS=120
LOCATION_THROTTLE_SECONDS=5
MAX_CONCURRENT_JOBS=5

# PayU (no defaults: must be provided via environment)
PAYU_KEY=
PAYU_SALT=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=

# create-admin.js (one-off script; prefer passing the password via env, not argv)
# ADMIN_USERNAME=admin
# ADMIN_PHONE=9999999999
# ADMIN_PASSWORD=
