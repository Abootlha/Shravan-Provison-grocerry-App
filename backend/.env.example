# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/shravankirana

# Redis Configuration
# Redis holds login sessions, so it must be persistent (AOF/RDB; the compose files
# use --appendonly yes) and must not evict keys (maxmemory-policy noeviction, the
# default). Wiping Redis signs every user out.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# HTTP
# Comma separated browser origins allowed by CORS (admin panel, website).
# Native mobile apps send no Origin header and are always allowed.
# In development, localhost / LAN / exp:// origins are also allowed automatically.
CORS_ORIGINS=https://admin.example.com,https://www.example.com
# Express "trust proxy" setting: number of reverse-proxy hops in front of the
# app (1 for a single nginx/load balancer), or true/false. Used for per-client rate limiting.
TRUST_PROXY=1

# JWT Authentication
# REQUIRED in production (boot fails without them): at least 32 random chars each,
# and the two must be different. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development, if unset, a random per-process secret is used (tokens die on restart).
JWT_SECRET=
JWT_REFRESH_SECRET=
# Access token lifetime ("15m", "2h", or seconds). Keep it short (15m-2h):
# the apps renew it silently with the refresh token.
JWT_EXPIRES_IN=15m

# Sessions (refresh tokens). One session per signed-in device, stored in Redis
# as refresh:{role}:{userId}:{sessionId}. Every refresh rotates the token and
# resets the idle timer, so a user who opens the app at least once per idle
# period stays signed in indefinitely ("persistent login").
# Customer and rider idle timeout in days. Default 365.
#   0 = no idle expiry: sessions never end on their own, only on logout,
#   logout-all, account disable/role change, or refresh-token reuse. Trade-off:
#   a lost or stolen phone stays signed in until someone revokes the session,
#   and Redis keeps one record per device forever. Only use 0 if the owner
#   explicitly wants it.
JWT_REFRESH_IDLE_DAYS=365
# Admin (staff) idle timeout in days. Default 28. 0 is not allowed for admins.
JWT_ADMIN_REFRESH_IDLE_DAYS=28
# A just-rotated refresh token is accepted again for this many seconds (the app
# may not have received the previous response on a flaky network). After that,
# presenting an old refresh token is treated as theft and the session is revoked.
JWT_REFRESH_REUSE_GRACE_SECONDS=300

# 2Factor.in OTP Service
# Required outside development (without it OTPs are only printed to the dev log).
TWOFACTOR_API_KEY=your-twofactor-api-key
# 2Factor SMS template name used for custom OTPs.
TWOFACTOR_TEMPLATE_NAME=OTP1
# OTP digits (4-6). The mobile apps currently expect 4; raise to 6 once they support it.
OTP_LENGTH=4

# Mappls / MapMyIndia APIs (Alternative - can be disabled if using Google Maps)
MAPMYINDIA_API_KEY=your-mappls-api-key-here
MAPMYINDIA_CLIENT_ID=your-mappls-client-id-here
MAPMYINDIA_CLIENT_SECRET=your-mappls-client-secret-here

# Google Maps API (Primary - for iOS/Android maps, search, tracking)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Store Location (for delivery radius and search bounding)
STORE_LATITUDE=26.7588
STORE_LONGITUDE=83.3700
STORE_MAX_DELIVERY_KM=15

# Socket.io Configuration
SOCKET_IO_CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Order Tracking Configuration
STALE_ORDER_THRESHOLD_MINUTES=10
ANOMALY_THRESHOLD_HOURS=2
ETA_RECALC_INTERVAL_MINUTES=5

# Performance Configuration
REDIS_CACHE_TTL_SECONDS=300
ETA_CACHE_TTL_SECONDS=120
LOCATION_THROTTLE_SECONDS=5
MAX_CONCURRENT_JOBS=5

# PayU (no defaults: must be provided via environment)
PAYU_KEY=
PAYU_SALT=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=

# create-admin.js (one-off script; prefer passing the password via env, not argv)
# ADMIN_USERNAME=admin
# ADMIN_PHONE=9999999999
# ADMIN_PASSWORD=

# Product image "pack shot" processing (background removal + square 800px PNG)
# Provider: none (default, normalise only when asked) | removebg | local
#   removebg: remove.bg HTTP API (paid credits), needs REMOVE_BG_API_KEY
#   local:    rembg CLI (MIT, runs offline). Install: pip install "rembg[cpu,cli]"
#             REMBG_BIN = command or full path (default: rembg). If missing, the
#             original image is kept and a warning is logged.
PRODUCT_IMAGE_BG_PROVIDER=none
REMOVE_BG_API_KEY=
REMBG_BIN=rembg
# Timeout for remove.bg / image download / rembg process (ms)
PRODUCT_IMAGE_TIMEOUT_MS=60000
# Batch job for existing products (dry run by default):
#   node --env-file=.env scripts/normalize-product-images.js [--apply] [--limit N] [--include-urls] [--force]
