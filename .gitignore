.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.kiro/
.opencode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
Thumbs.db

# Turborepo
.turbo/

# Temporary files
*.tmp
*.temp
.cache/
.expo/
**/.expo/

# Redis / database dumps
*.rdb
dump.rdb

# Scraper output dumps (tools/scraper keeps only source files)
tools/scraper/*.html
tools/scraper/*.png
tools/scraper/body.txt
tools/scraper/output.csv
tools/scraper/img_log.json
tools/scraper/links.txt

# TLS material for infrastructure/nginx (mounted at runtime, never committed)
infrastructure/nginx/ssl/
*.pem
*.key

