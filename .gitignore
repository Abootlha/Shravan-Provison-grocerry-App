.env
.env.*
**/.env
**/.env.*
.env.local
.env.*.local
.env.production
.env.test
!.env.example
!**/.env.example

# Build outputs
dist/
build/
*.tsbuildinfo

# Next.js
.next/
out/

# Test coverage
coverage/

# IDE / AI-tool workspaces
.DS_Store
.idea/
