# Root .env: used only by the local `docker compose` stack (docker-compose.yml).
# Copy to .env and replace every placeholder. Never commit .env.
#
# Each app has its own .env.example:
#   backend/.env.example, admin/.env.example, customer-app/.env.example,
#   apps/rider-app/.env.example
#
# Use URL-safe values (letters/digits) for passwords: they are embedded in
# MONGODB_URI. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# MongoDB root user (container is bound to 127.0.0.1:27017)
MONGO_ROOT_USERNAME=shravan
MONGO_ROOT_PASSWORD=change-me-mongo-password

# Redis requirepass (container is bound to 127.0.0.1:6379)
REDIS_PASSWORD=change-me-redis-password

# Backend NODE_ENV inside the container (development | production)
NODE_ENV=development
