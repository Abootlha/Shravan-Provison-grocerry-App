# Customer App Environment Configuration

# API Configuration
API_BASE_URL=http://localhost:3000/api/v1
TRACKING_WS_URL=ws://localhost:3008/tracking
LOCATION_SVC_URL=http://localhost:3005

# For development on physical device, replace localhost with your local IP
# Example: API_BASE_URL=http://192.168.1.100:3000/api/v1

# MapMyIndia API Key (for order tracking maps and geocoding)
# Get your API key from: https://apis.mapmyindia.com/
MAPMYINDIA_API_KEY=your_mapmyindia_api_key_here

# Socket.io Configuration
SOCKET_RECONNECTION_ATTEMPTS=10
SOCKET_RECONNECTION_DELAY=1000
SOCKET_PING_TIMEOUT=20000
SOCKET_PING_INTERVAL=10000

# App Configuration
APP_NAME=ShravanKirana
APP_VERSION=1.0.0

# Feature Flags
ENABLE_ORDER_TRACKING=true
ENABLE_PUSH_NOTIFICATIONS=false

# Environment
NODE_ENV=development
