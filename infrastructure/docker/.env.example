# Production stack env (infrastructure/docker/docker-compose.yml).
# Copy to .env next to the compose file and replace EVERY value. Never commit .env.
# Required values have no defaults: `docker compose` refuses to start without them.
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---- MongoDB (bundled container) ----
MONGO_ROOT_USERNAME=shravan
MONGO_ROOT_PASSWORD=change-me
# Must use the same credentials as above (URL-encode special characters),
# or point at MongoDB Atlas instead.
MONGODB_URI=mongodb://shravan:change-me@mongodb:27017/shravankirana?authSource=admin

# ---- Redis ----
REDIS_PASSWORD=change-me

# ---- Auth (each >= 32 chars, and different from each other) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# ---- HTTP ----
# Comma-separated browser origins allowed by the backend's CORS (admin panel, website).
CORS_ORIGINS=https://admin.example.com
# Public URL of the API (used for PayU callbacks) and where PayU redirects the user.
PUBLIC_API_URL=https://api.example.com/api/v1
PAYMENT_RETURN_URL=https://www.example.com/payment/return

# ---- Third-party services (see backend/.env.example for the full list) ----
TWOFACTOR_API_KEY=your-twofactor-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-server-key
MAPMYINDIA_API_KEY=your-mappls-api-key
MAPMYINDIA_CLIENT_ID=your-mappls-client-id
MAPMYINDIA_CLIENT_SECRET=your-mappls-client-secret
PAYU_KEY=
PAYU_SALT=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=

# ---- Store ----
STORE_LATITUDE=26.7588
STORE_LONGITUDE=83.3700
STORE_MAX_DELIVERY_KM=15

# Optional: image tag to run instead of building locally, e.g.
# BACKEND_IMAGE=ghcr.io/<owner>/<repo>/backend:latest
