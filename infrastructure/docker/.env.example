# =============================================================================
# ShravanKirana Microservices - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# =============================================================================
# Application Settings
# =============================================================================
NODE_ENV=development
APP_NAME=ShravanKirana
APP_URL=http://localhost
API_VERSION=v1

# =============================================================================
# MongoDB Configuration
# =============================================================================
# Local Development (when using docker-compose with mongodb service)
MONGODB_URI=mongodb://admin:admin123@localhost:27017/shravankirana?authSource=admin

# Production - Use MongoDB Atlas connection string
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/shravankirana?retryWrites=true&w=majority
MONGODB_USER=admin
MONGODB_PASSWORD=admin123

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://:redis123@localhost:6379
REDIS_PASSWORD=redis123
REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================================================
# RabbitMQ Configuration
# =============================================================================
RABBITMQ_URL=amqp://admin:admin123@localhost:5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# =============================================================================
# JWT & Authentication
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production-minimum-32-characters
JWT_REFRESH_EXPIRES_IN=30d

# API Gateway
API_GATEWAY_SECRET=api-gateway-secret-change-in-production
TRACKING_GATEWAY_SECRET=tracking-gateway-secret-change-in-prod

# =============================================================================
# MapMyIndia API (Location & Tracking)
# =============================================================================
MAPMYINDIA_API_KEY=your-mapmyindia-api-key
MAPMYINDIA_CLIENT_ID=your-mapmyindia-client-id
MAPMYINDIA_CLIENT_SECRET=your-mapmyindia-client-secret

# =============================================================================
# Payment Gateway (Razorpay)
# =============================================================================
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
PAYMENT_GATEWAY_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# SMS & Notifications (Twilio)
# =============================================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=your-verify-service-sid

# =============================================================================
# 2FA Service (2Factor.in)
# =============================================================================
TWO_FACTOR_API_KEY=your-2factor-api-key

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASS=your-email-app-password
EMAIL_FROM=noreply@shravankirana.com
EMAIL_FROM_NAME=ShravanKirana

# =============================================================================
# Push Notifications (Firebase Cloud Messaging)
# =============================================================================
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-firebase-project-id

# =============================================================================
# Google Maps API
# =============================================================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# =============================================================================
# Monitoring & Observability
# =============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# =============================================================================
# Service Ports (Internal)
# =============================================================================
AUTH_SVC_PORT=8001
USER_SVC_PORT=8002
RIDER_SVC_PORT=8003
ORDER_SVC_PORT=8004
PRODUCT_SVC_PORT=8005
CART_SVC_PORT=8006
PAYMENT_SVC_PORT=8007
NOTIFICATION_SVC_PORT=8008
LOCATION_SVC_PORT=8009
TRACKING_GW_PORT=8010
ANALYTICS_SVC_PORT=8011

# =============================================================================
# External Service URLs (for docker-compose networking)
# =============================================================================
AUTH_SVC_URL=http://auth-svc:8001
USER_SVC_URL=http://user-svc:8002
RIDER_SVC_URL=http://rider-svc:8003
ORDER_SVC_URL=http://order-svc:8004
PRODUCT_SVC_URL=http://product-svc:8005
CART_SVC_URL=http://cart-svc:8006
PAYMENT_SVC_URL=http://payment-svc:8007
NOTIFICATION_SVC_URL=http://notification-svc:8008
LOCATION_SVC_URL=http://location-svc:8009
TRACKING_GW_URL=http://tracking-gw:8010
ANALYTICS_SVC_URL=http://analytics-svc:8011

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_ORDER_TRACKING=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_2FA=false
ENABLE_ANALYTICS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
