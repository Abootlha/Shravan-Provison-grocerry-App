---
import AdminLayout from "../layouts/AdminLayout.astro";
---

<AdminLayout title="Pricing & Offers">
    <div class="dashboard-bg min-h-screen">
        <div class="relative z-10 p-6 lg:p-8 space-y-8">
            <!-- Header -->
            <div class="animate-slide-up delay-1">
                <div
                    class="flex flex-col lg:flex-row lg:items-end justify-between gap-6"
                >
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                            <svg
                                class="w-5 h-5"
                                style="color: var(--accent);"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <line x1="19" x2="5" y1="5" y2="19"></line>
                                <circle cx="6.5" cy="6.5" r="2.5"></circle>
                                <circle cx="17.5" cy="17.5" r="2.5"></circle>
                            </svg>
                            <span
                                class="text-xs font-semibold uppercase tracking-widest"
                                style="color: var(--text-muted);"
                            >
                                Revenue Management
                            </span>
                        </div>
                        <h1
                            class="font-display text-4xl font-bold tracking-tight"
                            style="color: var(--text-primary);"
                        >
                            Pricing & Offers
                        </h1>
                        <p
                            class="mt-2 text-lg"
                            style="color: var(--text-secondary);"
                        >
                            Manage product pricing, discounts, and promotional
                            offers
                        </p>
                    </div>
                    <button
                        class="px-5 py-2.5 rounded-xl font-semibold flex items-center gap-2 transition-all hover:-translate-y-0.5"
                        style="background: var(--accent-gradient); color: var(--bg-primary); box-shadow: 0 4px 14px rgba(230, 162, 60, 0.3);"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path d="M12 5v14M5 12h14"></path>
                        </svg>
                        Create Offer
                    </button>
                </div>
            </div>

            <!-- Stats Cards -->
            <div
                class="grid grid-cols-2 lg:grid-cols-4 gap-4 animate-slide-up delay-2"
            >
                <div class="kpi-card group">
                    <div class="flex items-center gap-4">
                        <div
                            class="icon-container icon-green group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <p class="metric-value">12</p>
                            <p
                                class="text-xs font-medium"
                                style="color: var(--text-muted);"
                            >
                                Active Offers
                            </p>
                        </div>
                    </div>
                </div>

                <div class="kpi-card group">
                    <div class="flex items-center gap-4">
                        <div
                            class="icon-container icon-amber group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <polygon
                                    points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                                ></polygon>
                            </svg>
                        </div>
                        <div>
                            <p class="metric-value">₹8.5K</p>
                            <p
                                class="text-xs font-medium"
                                style="color: var(--text-muted);"
                            >
                                Savings Given
                            </p>
                        </div>
                    </div>
                </div>

                <div class="kpi-card group">
                    <div class="flex items-center gap-4">
                        <div
                            class="icon-container icon-blue group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <rect
                                    width="18"
                                    height="18"
                                    x="3"
                                    y="4"
                                    rx="2"
                                    ry="2"></rect>
                                <line x1="16" x2="16" y1="2" y2="6"></line>
                                <line x1="8" x2="8" y1="2" y2="6"></line>
                                <line x1="3" x2="21" y1="10" y2="10"></line>
                            </svg>
                        </div>
                        <div>
                            <p class="metric-value">3</p>
                            <p
                                class="text-xs font-medium"
                                style="color: var(--text-muted);"
                            >
                                Scheduled
                            </p>
                        </div>
                    </div>
                </div>

                <div class="kpi-card group">
                    <div class="flex items-center gap-4">
                        <div
                            class="icon-container icon-orange group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <p class="metric-value">24</p>
                            <p
                                class="text-xs font-medium"
                                style="color: var(--text-muted);"
                            >
                                Coupons Used
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Area -->
            <div
                class="rounded-2xl p-8 flex flex-col items-center justify-center animate-slide-up delay-3"
                style="background: var(--bg-secondary); border: 1px solid var(--border); min-height: 400px;"
            >
                <div
                    class="w-20 h-20 rounded-2xl flex items-center justify-center mb-6 transition-transform hover:scale-110"
                    style="background: var(--bg-tertiary); border: 1px solid var(--border);"
                >
                    <svg
                        class="w-10 h-10"
                        style="color: var(--text-muted);"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <line x1="19" x2="5" y1="5" y2="19"></line>
                        <circle cx="6.5" cy="6.5" r="2.5"></circle>
                        <circle cx="17.5" cy="17.5" r="2.5"></circle>
                    </svg>
                </div>
                <h3
                    class="font-display text-xl font-semibold mb-2"
                    style="color: var(--text-primary);"
                >
                    Pricing & Offers Coming Soon
                </h3>
                <p
                    class="text-sm text-center max-w-md"
                    style="color: var(--text-muted);"
                >
                    This feature is under development. You will be able to
                    create discount offers, promotional coupons, and manage bulk
                    pricing here.
                </p>
            </div>
        </div>
    </div>
</AdminLayout>
