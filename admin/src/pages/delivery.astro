---
import AdminLayout from "../layouts/AdminLayout.astro";
---

<AdminLayout title="Delivery & Stores">
    <div class="dashboard-bg min-h-screen">
        <div class="relative z-10 p-6 lg:p-8 space-y-8">
            <!-- Header -->
            <div class="animate-slide-up delay-1">
                <div
                    class="flex flex-col lg:flex-row lg:items-end justify-between gap-6"
                >
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                            <svg
                                class="w-5 h-5"
                                style="color: var(--accent);"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"
                                ></path>
                                <path d="M15 18H9"></path>
                                <path
                                    d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"
                                ></path>
                                <circle cx="17" cy="18" r="2"></circle>
                                <circle cx="7" cy="18" r="2"></circle>
                            </svg>
                            <span
                                class="text-xs font-semibold uppercase tracking-widest"
                                style="color: var(--text-muted);"
                            >
                                Delivery Operations
                            </span>
                        </div>
                        <h1
                            class="font-display text-4xl font-bold tracking-tight"
                            style="color: var(--text-primary);"
                        >
                            Delivery & Stores
                        </h1>
                        <p
                            class="mt-2 text-lg"
                            style="color: var(--text-secondary);"
                        >
                            Configure delivery zones, timing, and store
                            locations
                        </p>
                    </div>
                    <button
                        class="px-5 py-2.5 rounded-xl font-semibold flex items-center gap-2 transition-all hover:-translate-y-0.5"
                        style="background: var(--accent-gradient); color: var(--bg-primary); box-shadow: 0 4px 14px rgba(230, 162, 60, 0.3);"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path d="M12 5v14M5 12h14"></path>
                        </svg>
                        Add Zone
                    </button>
                </div>
            </div>

            <!-- Stats Cards -->
            <div
                class="grid grid-cols-2 lg:grid-cols-4 gap-4 animate-slide-up delay-2"
            >
                <div class="kpi-card group">
                    <div class="flex items-center gap-4">
                        <div
                            class="icon-container icon-amber group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <circle cx="12" cy="10" r="3"></circle>
                                <path
                                    d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 6.9 8 11.7z"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <p class="metric-value">5</p>
                            <p
                                class="text-xs font-medium"
                                style="color: var(--text-muted);"
                            >
                                Delivery Zones
                            </p>
                        </div>
                    </div>
                </div>

                <div class="kpi-card group">
                    <div class="flex items-center gap-4">
                        <div
                            class="icon-container icon-green group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                        <div>
                            <p
                                class="metric-value"
                                style="color: var(--success);"
                            >
                                30 min
                            </p>
                            <p
                                class="text-xs font-medium"
                                style="color: var(--text-muted);"
                            >
                                Avg. Delivery
                            </p>
                        </div>
                    </div>
                </div>

                <div class="kpi-card group">
                    <div class="flex items-center gap-4">
                        <div
                            class="icon-container icon-blue group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                                ></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <line x1="19" x2="19" y1="8" y2="14"></line>
                                <line x1="22" x2="16" y1="11" y2="11"></line>
                            </svg>
                        </div>
                        <div>
                            <p class="metric-value" style="color: var(--info);">
                                3
                            </p>
                            <p
                                class="text-xs font-medium"
                                style="color: var(--text-muted);"
                            >
                                Delivery Partners
                            </p>
                        </div>
                    </div>
                </div>

                <div class="kpi-card group">
                    <div class="flex items-center gap-4">
                        <div
                            class="icon-container icon-orange group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <rect
                                    width="16"
                                    height="20"
                                    x="4"
                                    y="2"
                                    rx="2"
                                    ry="2"></rect>
                                <path d="M9 22v-4h6v4"></path>
                                <path d="M8 6h.01"></path>
                                <path d="M16 6h.01"></path>
                                <path d="M12 6h.01"></path>
                                <path d="M12 10h.01"></path>
                                <path d="M12 14h.01"></path>
                                <path d="M16 10h.01"></path>
                                <path d="M16 14h.01"></path>
                                <path d="M8 10h.01"></path>
                                <path d="M8 14h.01"></path>
                            </svg>
                        </div>
                        <div>
                            <p class="metric-value">1</p>
                            <p
                                class="text-xs font-medium"
                                style="color: var(--text-muted);"
                            >
                                Store Locations
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Area -->
            <div
                class="rounded-2xl p-8 flex flex-col items-center justify-center animate-slide-up delay-3"
                style="background: var(--bg-secondary); border: 1px solid var(--border); min-height: 400px;"
            >
                <div
                    class="w-20 h-20 rounded-2xl flex items-center justify-center mb-6 transition-transform hover:scale-110"
                    style="background: var(--bg-tertiary); border: 1px solid var(--border);"
                >
                    <svg
                        class="w-10 h-10"
                        style="color: var(--text-muted);"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"
                        ></path>
                        <path d="M15 18H9"></path>
                        <path
                            d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"
                        ></path>
                        <circle cx="17" cy="18" r="2"></circle>
                        <circle cx="7" cy="18" r="2"></circle>
                    </svg>
                </div>
                <h3
                    class="font-display text-xl font-semibold mb-2"
                    style="color: var(--text-primary);"
                >
                    Delivery Management Coming Soon
                </h3>
                <p
                    class="text-sm text-center max-w-md"
                    style="color: var(--text-muted);"
                >
                    This feature is under development. You will be able to
                    configure delivery zones, set delivery charges, manage
                    delivery partners, and set store operating hours here.
                </p>
            </div>
        </div>
    </div>
</AdminLayout>
