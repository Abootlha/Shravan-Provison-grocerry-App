---
import "../styles/global.css";
import LoginForm from "../components/login/LoginForm";
import { THEME_INIT_SCRIPT } from "../lib/theme";
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Sign in · Shravan Kirana Admin</title>
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <script is:inline>
      // Skip the form only for a token that is still valid (JWT exp claim). An expired token
      // stays put so the guard on protected pages can try a refresh.
      (function () {
        try {
          var token = localStorage.getItem("adminToken");
          var part = token && token.split(".")[1];
          if (!part) return;
          var claims = JSON.parse(atob(part.replace(/-/g, "+").replace(/_/g, "/")));
          if (typeof claims.exp === "number" && Date.now() < claims.exp * 1000) {
            window.location.replace("/");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main class="flex min-h-dvh flex-col items-center justify-center px-4 py-10">
      <div class="flex w-full max-w-sm flex-col gap-6">
        <div class="flex items-center gap-3">
          <span class="flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 11-1 9"></path><path d="m19 11-4-7"></path><path d="M2 11h20"></path><path d="m3.5 11 1.6 7.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6l1.7-7.4"></path><path d="M4.5 15.5h15"></path><path d="m5 11 4-7"></path><path d="m9 11 1 9"></path>
            </svg>
          </span>
          <div class="leading-tight">
            <p class="text-base font-bold tracking-tight">Shravan Kirana</p>
            <p class="text-sm text-muted-foreground">Store admin</p>
          </div>
        </div>
        <LoginForm client:load />
        <p class="text-center text-xs text-muted-foreground">
          Trouble signing in? Ask the store owner to reset your password.
        </p>
      </div>
    </main>
  </body>
</html>
