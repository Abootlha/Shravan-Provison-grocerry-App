---
import "../styles/global.css";
import AppShell from "../components/shell/AppShell";
import { getApiBaseUrl } from "../lib/config";
import { THEME_INIT_SCRIPT } from "../lib/theme";

const apiBase = getApiBaseUrl();

interface Props {
  title: string;
  /** Overrides the breadcrumbs derived from the sidebar navigation. */
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, breadcrumbs } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Shravan Kirana Admin</title>
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <style is:inline>
      html.auth-pending body { visibility: hidden; }
    </style>
    <!--
      Auth guard: runs before the body renders so protected pages never flash for
      signed-out users. Valid access token -> show page. Expired access token with a
      refresh token -> refresh once, then show. Otherwise -> /login.
      The refresh promise is published on window.__adminSessionRefresh so the API client
      reuses it instead of firing a second /auth/refresh (refresh tokens rotate).
      The API still enforces auth on every request; this only gates the UI.
    -->
    <script is:inline define:vars={{ apiBase }}>
      (function () {
        var root = document.documentElement;
        root.classList.add("auth-pending");

        function clearSession() {
          ["adminToken", "adminRefreshToken", "adminUser", "adminLoginTime"].forEach(function (k) {
            localStorage.removeItem(k);
          });
        }
        function toLogin(reason) {
          try { clearSession(); } catch (e) {}
          window.location.replace("/login" + (reason ? "?reason=" + encodeURIComponent(reason) : ""));
        }
        function reveal() {
          root.classList.remove("auth-pending");
        }
        function isExpired(token) {
          try {
            var part = token.split(".")[1];
            if (part) {
              var b64 = part.replace(/-/g, "+").replace(/_/g, "/");
              b64 += "===".slice((b64.length + 3) % 4);
              var claims = JSON.parse(atob(b64));
              if (typeof claims.exp === "number") {
                return Date.now() >= claims.exp * 1000 - 5000;
              }
            }
          } catch (e) {}
          var loginTime = parseInt(localStorage.getItem("adminLoginTime") || "", 10);
          return !isFinite(loginTime) || Date.now() - loginTime > 2 * 60 * 60 * 1000;
        }

        try {
          var token = localStorage.getItem("adminToken");
          var refreshToken = localStorage.getItem("adminRefreshToken");

          if (token && !isExpired(token)) {
            reveal();
            return;
          }
          if (!refreshToken) {
            toLogin();
            return;
          }

          window.__adminSessionRefresh = fetch(apiBase + "/auth/refresh", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ refreshToken: refreshToken }),
          })
            .then(function (res) {
              // 401 = the session is over (body.code says why). Anything else
              // (5xx) is transient: show the page; API calls retry the refresh.
              if (res.status === 401) {
                return res.json().catch(function () { return {}; }).then(function (body) {
                  var reason = (body && body.code) || "SESSION_EXPIRED";
                  toLogin(reason);
                  return { status: "ended", reason: reason };
                });
              }
              if (!res.ok) {
                reveal();
                return { status: "unavailable" };
              }
              return res.json().then(function (data) {
                if (!data || !data.accessToken) {
                  toLogin();
                  return { status: "ended", reason: "SESSION_EXPIRED" };
                }
                localStorage.setItem("adminToken", data.accessToken);
                if (data.refreshToken) localStorage.setItem("adminRefreshToken", data.refreshToken);
                localStorage.setItem("adminLoginTime", String(Date.now()));
                reveal();
                return { status: "ok", token: data.accessToken };
              });
            })
            .catch(function () {
              // Offline: keep the session and show the page.
              reveal();
              return { status: "unavailable" };
            });
        } catch (e) {
          toLogin();
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-[60] rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground focus:not-sr-only focus:fixed focus:left-3 focus:top-3"
    >
      Skip to content
    </a>
    <AppShell client:load title={title} pathname={pathname} breadcrumbs={breadcrumbs}>
      <slot />
    </AppShell>
  </body>
</html>
