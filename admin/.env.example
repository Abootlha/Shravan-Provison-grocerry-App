# Admin dashboard env vars. Copy to admin/.env (never commit .env).
# PUBLIC_* values are baked into the static build and are visible to anyone
# who loads the site, so never put secrets here.

# NestJS backend API base URL, including the /api/v1 prefix.
# Required for `npm run build` (the build fails if unset).
# In `npm run dev` it defaults to http://localhost:3000/api/v1.
PUBLIC_API_URL=http://localhost:3000/api/v1

# Socket.io tracking namespace on the backend.
# Required for `npm run build`; dev default is http://localhost:3000/tracking.
PUBLIC_TRACKING_URL=http://localhost:3000/tracking

# Optional: override the socket URL (defaults to PUBLIC_TRACKING_URL).
# PUBLIC_SOCKET_URL=

# Optional integrations. Use a browser key restricted by HTTP referrer.
PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Socket.io Configuration
PUBLIC_SOCKET_RECONNECTION_ATTEMPTS=5
PUBLIC_SOCKET_RECONNECTION_DELAY=1000

# Admin Dashboard Configuration
PUBLIC_APP_NAME=ShravanKirana Admin
PUBLIC_APP_VERSION=1.0.0

# Feature Flags
PUBLIC_ENABLE_RIDER_TRACKING=true
PUBLIC_ENABLE_REAL_TIME_UPDATES=true
