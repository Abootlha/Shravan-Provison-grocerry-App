# Admin Dashboard Environment Configuration

# API Configuration
PUBLIC_API_BASE_URL=https://api.lumioui.com/api/v1
PUBLIC_AUTH_SERVICE_URL=https://api.lumioui.com/api/v1
PUBLIC_PRODUCT_SERVICE_URL=https://api.lumioui.com/api/v1
PUBLIC_ORDER_SERVICE_URL=https://api.lumioui.com/api/v1
PUBLIC_RIDER_SERVICE_URL=https://api.lumioui.com/api/v1
PUBLIC_ANALYTICS_SERVICE_URL=https://api.lumioui.com/api/v1
PUBLIC_SETTINGS_SERVICE_URL=https://api.lumioui.com/api/v1
PUBLIC_SUBCATEGORY_SERVICE_URL=https://api.lumioui.com/api/v1
PUBLIC_ITEM_GROUP_SERVICE_URL=https://api.lumioui.com/api/v1
PUBLIC_TRACKING_SERVICE_URL=https://api.lumioui.com/tracking
PUBLIC_SOCKET_URL=https://api.lumioui.com/tracking

# Google Maps API Key (for rider tracking maps)
PUBLIC_GOOGLE_MAPS_API_KEY=

# Socket.io Configuration
PUBLIC_SOCKET_RECONNECTION_ATTEMPTS=5
PUBLIC_SOCKET_RECONNECTION_DELAY=1000

# Admin Dashboard Configuration
PUBLIC_APP_NAME=ShravanKirana Admin
PUBLIC_APP_VERSION=1.0.0

# Feature Flags
PUBLIC_ENABLE_RIDER_TRACKING=true
PUBLIC_ENABLE_REAL_TIME_UPDATES=true

# Environment
PUBLIC_NODE_ENV=development

# Note: In Astro, all environment variables exposed to the client must be prefixed with PUBLIC_
