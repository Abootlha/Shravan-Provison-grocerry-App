# Single switch:
# - PUBLIC_NODE_ENV=production  -> https://api.lumioui.com
# - PUBLIC_NODE_ENV=development -> http://localhost:3000

# Keep these values in sync with the selected PUBLIC_NODE_ENV.
# For production use api.lumioui.com, for development use localhost:3000.

# Shared API gateway
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Optional service-specific overrides
PUBLIC_AUTH_SERVICE_URL=http://localhost:3000/api/v1
PUBLIC_PRODUCT_SERVICE_URL=http://localhost:3000/api/v1
PUBLIC_ORDER_SERVICE_URL=http://localhost:3000/api/v1
PUBLIC_RIDER_SERVICE_URL=http://localhost:3000/api/v1
PUBLIC_ANALYTICS_SERVICE_URL=http://localhost:3000/api/v1
PUBLIC_SETTINGS_SERVICE_URL=http://localhost:3000/api/v1
PUBLIC_SUBCATEGORY_SERVICE_URL=http://localhost:3000/api/v1
PUBLIC_ITEM_GROUP_SERVICE_URL=http://localhost:3000/api/v1

# Real-time services
PUBLIC_TRACKING_SERVICE_URL=http://localhost:3000/tracking
PUBLIC_SOCKET_URL=http://localhost:3000/tracking

# Optional integrations
PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAsiP7CR40fAir7Wz81RvQ1qf7eZTIZGpk

# Socket.io Configuration
PUBLIC_SOCKET_RECONNECTION_ATTEMPTS=5
PUBLIC_SOCKET_RECONNECTION_DELAY=1000

# Admin Dashboard Configuration
PUBLIC_APP_NAME=ShravanKirana Admin
PUBLIC_APP_VERSION=1.0.0

# Feature Flags
PUBLIC_ENABLE_RIDER_TRACKING=true
PUBLIC_ENABLE_REAL_TIME_UPDATES=true

# Environment
PUBLIC_NODE_ENV=development
